# ---- Geral ----
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Banco ----
DATABASE_URL=postgresql://insurance:insurance@localhost:5433/insurance
# usado apenas pelos testes de integração
DATABASE_URL_TEST=postgresql://insurance:insurance@localhost:5433/insurance_test

# ---- Auth ----
# gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---- Storage (S3-compatible; MinIO em dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=insurance-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Upload / PDF ----
MAX_UPLOAD_MB=10
# vazio = Chromium baixado pelo puppeteer; no Docker aponta para o chromium do sistema
PUPPETEER_EXECUTABLE_PATH=

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
